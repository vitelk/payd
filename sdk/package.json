{
  "name": "@paydprotocol/sdk",
  "version": "0.1.0",
  "description": "Drop your token's Payd payout onto your site: one custom element, or a headless API.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/payd.js",
  "module": "./dist/payd.js",
  "types": "./dist/types/sdk/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/sdk/src/index.d.ts",
      "default": "./dist/payd.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "./dist/payd.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.types.json",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/payd.test.ts"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "typescript": "^5.6.0",
    "tsx": "^4.19.0"
  }
}
